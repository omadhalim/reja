<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/main.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
  <title>Portfolio</title>
</head>
<body>
   <div>
    <div class="frame">
      <div class="main_frame">
      
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1-1">
              <img
              src="/images/profile.png" 
              width="156px" 
              height="142px" 
              alt=""
               />
            </div>
            <div class="left_1-2"><%=user.name%></div> 
            <div class="left_1-3"><%=user.profession%></div>
            <div class="left-icons">
              <a class="link_href" href="">
                <div class="icon">
              <img src="icon/Vector-1.svg" class="icon-1" />
            </div>
            </a>
            <a class="link_href" href="">
                <div class="icon">
              <img src="icon/Vector-2.svg" class="icon-1" />
            </div>
            </a>
            <a class="link_href" href="">
                <div class="icon">
              <img src="icon/Vector-3.svg" class="icon-1" />
            </div>
            </a>
            <a class="link_href" href="">
                <div class="icon">
              <img src="icon/Vector-4.svg" class="icon-1" />
            </div>
            </a>
            <a class="link_href" href="">
                <div class="icon">
              <img src="icon/Vector-5.svg" class="icon-1" />
            </div>
            </a>
            <a class="link_href" href="">
                <div class="icon">
              <img src="icon/Vector-6.svg" class="icon-1" /> 
            </div>
            </a>
          </div>
          <div class="marginer"></div>
          <div class="left_2">
            <div class="info-container">
            <div class="left_2-info-item">
              <span class="label">Age:</span>
              <span class="value">24</span>

            </div>
            <div class="left_2-info-item">
              <span class="label">Residance</span>
              <span class="value">BD</span>
            </div>
            <div class="left_2-info-item">
              <span class="label">Freelance:</span>
              <span class="value available">Available</span>
            </div>
            <div class="left_2-info-item">
              <span class="label">Address:</span>
              <span class="value">Dhaka,Bangladesh</span>

            </div>
            </div>
            
          </div>
          <div class="marginer"></div>
          <div class="left_3">
            <div class="languages-section">
          <h3>Languages</h3>


  <div class="skill-item">
    <div class="skill-info">
      <span>Bangla</span>
      <span>100%</span>
    </div>
    <div class="progress-bar">
      <div class="progress" style="width: 100%;"></div>
    </div>
  </div>

  
  <div class="skill-item">
    <div class="skill-info">
      <span>English</span>
      <span>80%</span>
    </div>
    <div class="progress-bar">
      <div class="progress" style="width: 80%;"></div>
    </div>
  </div>

  
  <div class="skill-item">
    <div class="skill-info">
      <span>Spanish</span>
      <span>60%</span>
    </div>
    <div class="progress-bar">
      <div class="progress" style="width: 60%;"></div>
    </div>
  </div>
</div>
          </div>  
          <div class="marginer"></div>
          <div class="left_4"></div>
          <div class="marginer"></div>
          <div class="left_5"></div>
          <div class="marginer"></div>
          
        </div>
        <div class="midd_frame">
          <div></div>
        </div>
        <div class="right_frame"></div>    
      </div>

    </div>
   </div>  

</body>

</html>
